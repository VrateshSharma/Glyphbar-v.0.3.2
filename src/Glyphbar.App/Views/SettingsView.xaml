<UserControl
    x:Class="Glyphbar.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Glyphbar.App.ViewModels"
    xmlns:comp="using:Glyphbar.App.Components">
    <Grid Background="{StaticResource GbBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Padding="20,44,12,20" Spacing="16">
            <comp:DotMatrixText Text="SETTINGS" DotSize="2.4" Gap="1" />
            <ListView x:Name="Sections" SelectedIndex="{x:Bind ViewModel.SectionIndex, Mode=TwoWay}">
                <x:String>Appearance</x:String>
                <x:String>Taskbar</x:String>
                <x:String>Widgets</x:String>
                <x:String>Search</x:String>
                <x:String>System</x:String>
                <x:String>About</x:String>
            </ListView>
        </StackPanel>

        <ScrollViewer Grid.Column="1" Padding="24,44,28,28">
            <Grid>
                <!-- Appearance -->
                <StackPanel Spacing="18" Visibility="{x:Bind ViewModel.IsSection(0, ViewModel.SectionIndex), Mode=OneWay}">
                    <TextBlock Text="Appearance" Style="{StaticResource GbTitle}" />
                    <ComboBox Header="Panel material" SelectedIndex="{x:Bind ViewModel.BackdropIndex, Mode=TwoWay}" MinWidth="240">
                        <x:String>Opaque</x:String>
                        <x:String>Acrylic</x:String>
                    </ComboBox>
                    <ComboBox Header="Animation" SelectedIndex="{x:Bind ViewModel.AnimationIndex, Mode=TwoWay}" MinWidth="240">
                        <x:String>Off</x:String>
                        <x:String>Subtle</x:String>
                        <x:String>Full</x:String>
                    </ComboBox>
                    <ComboBox Header="Font" ItemsSource="{x:Bind ViewModel.Fonts}" SelectedItem="{x:Bind ViewModel.FontFamily, Mode=TwoWay}" MinWidth="240" />
                    <ToggleSwitch Header="Monochrome application icons" IsOn="{x:Bind ViewModel.MonochromeIcons, Mode=TwoWay}" />
                    <TextBlock Text="Windows' Animation effects setting always overrides this. Glyphbar is dark-only by design." Style="{StaticResource GbCaption}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Taskbar -->
                <StackPanel Spacing="18" Visibility="{x:Bind ViewModel.IsSection(1, ViewModel.SectionIndex), Mode=OneWay}">
                    <TextBlock Text="Taskbar" Style="{StaticResource GbTitle}" />
                    <ToggleSwitch Header="Show taskbar" IsOn="{x:Bind ViewModel.TaskbarVisible, Mode=TwoWay}" />
                    <ComboBox Header="Position" SelectedIndex="{x:Bind ViewModel.EdgeIndex, Mode=TwoWay}" MinWidth="240">
                        <x:String>Bottom</x:String>
                        <x:String>Top</x:String>
                    </ComboBox>
                    <ComboBox Header="Alignment" SelectedIndex="{x:Bind ViewModel.AlignmentIndex, Mode=TwoWay}" MinWidth="240">
                        <x:String>Left</x:String>
                        <x:String>Centre</x:String>
                        <x:String>Right</x:String>
                    </ComboBox>
                    <ToggleSwitch Header="Floating dock" IsOn="{x:Bind ViewModel.Floating, Mode=TwoWay}" />
                    <ToggleSwitch Header="Auto-hide" IsOn="{x:Bind ViewModel.AutoHide, Mode=TwoWay}" />
                    <Slider Header="Width (%)" Minimum="20" Maximum="100" StepFrequency="1" Value="{x:Bind ViewModel.WidthPercent, Mode=TwoWay}" />
                    <Slider Header="Height" Minimum="36" Maximum="96" StepFrequency="1" Value="{x:Bind ViewModel.BarHeight, Mode=TwoWay}" />
                    <Slider Header="Icon size" Minimum="16" Maximum="48" StepFrequency="1" Value="{x:Bind ViewModel.IconSize, Mode=TwoWay}" />
                    <Slider Header="Corner radius" Minimum="0" Maximum="48" StepFrequency="1" Value="{x:Bind ViewModel.CornerRadius, Mode=TwoWay}" />
                    <Slider Header="Opacity (%)" Minimum="30" Maximum="100" StepFrequency="1" Value="{x:Bind ViewModel.OpacityPercent, Mode=TwoWay}" />
                    <ToggleSwitch Header="Running indicators" IsOn="{x:Bind ViewModel.ShowIndicators, Mode=TwoWay}" />
                    <ToggleSwitch Header="Show running apps that aren't pinned" IsOn="{x:Bind ViewModel.ShowUnpinned, Mode=TwoWay}" />
                    <ToggleSwitch Header="Clock" IsOn="{x:Bind ViewModel.ShowClock, Mode=TwoWay}" />
                    <ToggleSwitch Header="Date" IsOn="{x:Bind ViewModel.ShowDate, Mode=TwoWay}" />
                    <ToggleSwitch Header="System status" IsOn="{x:Bind ViewModel.ShowStatus, Mode=TwoWay}" />
                    <StackPanel Spacing="8">
                        <TextBlock Text="To make Glyphbar your only visible taskbar, turn on 'Automatically hide the taskbar' in Windows. Glyphbar never changes this for you." Style="{StaticResource GbCaption}" TextWrapping="Wrap" />
                        <Button Content="Open Windows taskbar settings" Command="{x:Bind ViewModel.OpenWindowsTaskbarSettingsCommand}" CornerRadius="10" />
                    </StackPanel>
                </StackPanel>

                <!-- Widgets -->
                <StackPanel Spacing="18" Visibility="{x:Bind ViewModel.IsSection(2, ViewModel.SectionIndex), Mode=OneWay}">
                    <TextBlock Text="Widgets" Style="{StaticResource GbTitle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Widgets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WidgetRowViewModel">
                                <Grid ColumnSpacing="6" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource GbBody}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="{x:Bind SizeLabel, Mode=OneWay}" Command="{x:Bind CycleSizeCommand}" MinWidth="80" CornerRadius="10" AutomationProperties.Name="{x:Bind SizeButtonLabel}" />
                                    <Button Grid.Column="2" Style="{StaticResource GbIconButton}" Command="{x:Bind MoveUpCommand}" ToolTipService.ToolTip="Move earlier" AutomationProperties.Name="Move earlier"><FontIcon Glyph="&#xE70E;" FontSize="12" /></Button>
                                    <Button Grid.Column="3" Style="{StaticResource GbIconButton}" Command="{x:Bind MoveDownCommand}" ToolTipService.ToolTip="Move later" AutomationProperties.Name="Move later"><FontIcon Glyph="&#xE70D;" FontSize="12" /></Button>
                                    <ToggleSwitch Grid.Column="4" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="{x:Bind EnabledLabel}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ComboBox Header="Clock format" SelectedIndex="{x:Bind ViewModel.ClockFormatIndex, Mode=TwoWay}" MinWidth="240">
                        <x:String>Follow Windows</x:String>
                        <x:String>12-hour</x:String>
                        <x:String>24-hour</x:String>
                    </ComboBox>
                    <ComboBox Header="Time zone" ItemsSource="{x:Bind ViewModel.TimeZones}" SelectedIndex="{x:Bind ViewModel.TimeZoneIndex, Mode=TwoWay}" MinWidth="320" />
                    <ToggleSwitch Header="Show seconds" IsOn="{x:Bind ViewModel.ShowSeconds, Mode=TwoWay}" />
                    <ToggleSwitch Header="Dot-matrix clock" IsOn="{x:Bind ViewModel.DotMatrixClock, Mode=TwoWay}" />
                    <ToggleSwitch Header="Resource monitoring" IsOn="{x:Bind ViewModel.ResourceMonitoring, Mode=TwoWay}" />
                    <Slider Header="Battery refresh (seconds)" Minimum="10" Maximum="120" StepFrequency="5" Value="{x:Bind ViewModel.BatteryRefresh, Mode=TwoWay}" />
                    <Slider Header="Storage refresh (seconds)" Minimum="30" Maximum="300" StepFrequency="10" Value="{x:Bind ViewModel.StorageRefresh, Mode=TwoWay}" />
                    <Slider Header="Low battery warning (%)" Minimum="11" Maximum="40" StepFrequency="1" Value="{x:Bind ViewModel.BatteryLow, Mode=TwoWay}" />
                    <Slider Header="Critical battery warning (%)" Minimum="2" Maximum="10" StepFrequency="1" Value="{x:Bind ViewModel.BatteryCritical, Mode=TwoWay}" />
                </StackPanel>

                <!-- Search -->
                <StackPanel Spacing="18" Visibility="{x:Bind ViewModel.IsSection(3, ViewModel.SectionIndex), Mode=OneWay}">
                    <TextBlock Text="Search" Style="{StaticResource GbTitle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Hotkeys}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HotkeyRowViewModel">
                                <StackPanel Spacing="4" Margin="0,0,0,12">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Header="{x:Bind Label}" Text="{x:Bind Gesture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Alt+Space" />
                                        <Button Grid.Column="1" Content="Apply" Command="{x:Bind ApplyCommand}" VerticalAlignment="Bottom" CornerRadius="10" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource GbCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ToggleSwitch Header="Applications" IsOn="{x:Bind ViewModel.SearchApps, Mode=TwoWay}" />
                    <ToggleSwitch Header="Files" IsOn="{x:Bind ViewModel.SearchFiles, Mode=TwoWay}" />
                    <ToggleSwitch Header="Folders" IsOn="{x:Bind ViewModel.SearchFolders, Mode=TwoWay}" />
                    <ToggleSwitch Header="Settings shortcuts" IsOn="{x:Bind ViewModel.SearchSettings, Mode=TwoWay}" />
                    <ToggleSwitch Header="Keep search history" IsOn="{x:Bind ViewModel.KeepHistory, Mode=TwoWay}" />
                    <Button Content="Clear search history" Command="{x:Bind ViewModel.ClearHistoryCommand}" CornerRadius="10" />
                    <TextBox Header="Limit file search to these folders (one per line; empty searches everything indexed)" Text="{x:Bind ViewModel.IndexedLocations, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
                    <Button Content="Open Windows indexing options" Command="{x:Bind ViewModel.OpenIndexingCommand}" CornerRadius="10" />
                    <Slider Header="Launcher icon size" Minimum="24" Maximum="96" StepFrequency="2" Value="{x:Bind ViewModel.LauncherIconSize, Mode=TwoWay}" />
                    <Slider Header="Launcher grid spacing" Minimum="0" Maximum="48" StepFrequency="2" Value="{x:Bind ViewModel.LauncherSpacing, Mode=TwoWay}" />
                </StackPanel>

                <!-- System -->
                <StackPanel Spacing="18" Visibility="{x:Bind ViewModel.IsSection(4, ViewModel.SectionIndex), Mode=OneWay}">
                    <TextBlock Text="System" Style="{StaticResource GbTitle}" />
                    <ToggleSwitch Header="Launch at Windows sign-in" IsOn="{x:Bind ViewModel.LaunchAtStartup, Mode=TwoWay}" />
                    <ToggleSwitch Header="Low-battery notifications" IsOn="{x:Bind ViewModel.Notifications, Mode=TwoWay}" />
                    <ComboBox Header="Multiple monitors" SelectedIndex="{x:Bind ViewModel.MultiMonitorIndex, Mode=TwoWay}" MinWidth="240">
                        <x:String>Primary monitor only</x:String>
                        <x:String>All monitors</x:String>
                    </ComboBox>
                    <ToggleSwitch Header="Confirm sign out" IsOn="{x:Bind ViewModel.ConfirmSignOut, Mode=TwoWay}" />
                    <ToggleSwitch Header="Confirm sleep" IsOn="{x:Bind ViewModel.ConfirmSleep, Mode=TwoWay}" />
                    <Slider Header="Countdown after confirming (seconds, 0 for none)" Minimum="0" Maximum="30" StepFrequency="1" Value="{x:Bind ViewModel.PowerCountdown, Mode=TwoWay}" />
                    <TextBlock Text="Shut down and restart always ask for confirmation." Style="{StaticResource GbCaption}" />
                </StackPanel>

                <!-- About -->
                <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.IsSection(5, ViewModel.SectionIndex), Mode=OneWay}">
                    <TextBlock Text="About" Style="{StaticResource GbTitle}" />
                    <TextBlock Text="{x:Bind ViewModel.VersionText}" Style="{StaticResource GbBody}" />
                    <TextBlock Text="{x:Bind ViewModel.BuildText}" Style="{StaticResource GbCaption}" TextWrapping="Wrap" />
                    <Button Content="Open logs" Command="{x:Bind ViewModel.OpenLogsCommand}" CornerRadius="10" />
                    <Button Content="Restart interface" Command="{x:Bind ViewModel.RestartInterfaceCommand}" CornerRadius="10" />
                    <Button Content="Reset all settings" Click="OnResetClick" CornerRadius="10" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
