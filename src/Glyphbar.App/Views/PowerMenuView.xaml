<UserControl
    x:Class="Glyphbar.App.Views.PowerMenuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comp="using:Glyphbar.App.Components"
    xmlns:vm="using:Glyphbar.App.ViewModels">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <comp:DotMatrixText Text="POWER" DotSize="3" Gap="1.2" />

        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.Actions}" Visibility="{x:Bind ViewModel.ShowActions, Mode=OneWay}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PowerActionViewModel">
                    <Button Style="{StaticResource GbIconButton}" Width="96" Height="104" Command="{x:Bind SelectCommand}" ToolTipService.ToolTip="{x:Bind Description}">
                        <StackPanel Spacing="10">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="22" />
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource GbBody}" TextAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="1" Spacing="14" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.ShowConfirm, Mode=OneWay}">
            <TextBlock Text="{x:Bind ViewModel.ConfirmTitle, Mode=OneWay}" Style="{StaticResource GbTitle}" TextAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.ConfirmText, Mode=OneWay}" Style="{StaticResource GbSecondary}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button x:Name="CancelButton" Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" MinWidth="120" CornerRadius="10" />
                <Button Content="{x:Bind ViewModel.ConfirmButton, Mode=OneWay}" Command="{x:Bind ViewModel.ConfirmCommand}" Visibility="{x:Bind ViewModel.ShowConfirmButton, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" MinWidth="120" CornerRadius="10" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.Error, Mode=OneWay}" Style="{StaticResource GbCaption}" TextWrapping="Wrap" TextAlignment="Center" />
    </Grid>
</UserControl>
