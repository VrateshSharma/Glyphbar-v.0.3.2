<UserControl
    x:Class="Glyphbar.App.Views.LauncherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Glyphbar.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="TileTemplate" x:DataType="vm:LauncherTileViewModel">
            <StackPanel Width="{x:Bind TileWidth, Mode=OneWay}" Spacing="6" Padding="4,8" Background="Transparent" ToolTipService.ToolTip="{x:Bind Name}" RightTapped="OnTileRightTapped">
                <Grid Width="{x:Bind IconSize, Mode=OneWay}" Height="{x:Bind IconSize, Mode=OneWay}" HorizontalAlignment="Center">
                    <Image Source="{x:Bind Icon, Mode=OneWay}" />
                </Grid>
                <TextBlock Text="{x:Bind Name}" Style="{StaticResource GbCaption}" Foreground="{StaticResource GbTextBrush}" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Filter" PlaceholderText="Find an app" Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="10" />
            <Button Grid.Column="1" Content="Add application" Command="{x:Bind ViewModel.AddApplicationCommand}" CornerRadius="10" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="4" Visibility="{x:Bind ViewModel.ShowFavourites, Mode=OneWay}">
            <TextBlock Text="FAVOURITES" Style="{StaticResource GbLabel}" />
            <GridView x:Name="Favourites" ItemsSource="{x:Bind ViewModel.Favourites}" ItemTemplate="{StaticResource TileTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnTileClick" CanDragItems="True" CanReorderItems="True" AllowDrop="True" DragItemsCompleted="OnFavouritesReordered" ContainerContentChanging="OnContainerContentChanging" MaxHeight="124" ScrollViewer.VerticalScrollBarVisibility="Hidden" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="4" Visibility="{x:Bind ViewModel.ShowRecent, Mode=OneWay}">
            <TextBlock Text="RECENT" Style="{StaticResource GbLabel}" />
            <GridView ItemsSource="{x:Bind ViewModel.Recent}" ItemTemplate="{StaticResource TileTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnTileClick" ContainerContentChanging="OnContainerContentChanging" MaxHeight="124" ScrollViewer.VerticalScrollBarVisibility="Hidden" />
        </StackPanel>

        <Grid Grid.Row="3" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="ALL APPLICATIONS" Style="{StaticResource GbLabel}" />
            <GridView x:Name="All" Grid.Row="1" ItemsSource="{x:Bind ViewModel.All}" ItemTemplate="{StaticResource TileTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnTileClick" ContainerContentChanging="OnContainerContentChanging" />
            <TextBlock Grid.Row="1" Text="No applications match." Style="{StaticResource GbSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.ShowNoMatches, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
