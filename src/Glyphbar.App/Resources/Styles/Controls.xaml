<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GbBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource GbTextBrush}" />
    </Style>
    <Style x:Key="GbSecondary" TargetType="TextBlock" BasedOn="{StaticResource GbBody}">
        <Setter Property="Foreground" Value="{StaticResource GbTextSecondaryBrush}" />
    </Style>
    <Style x:Key="GbCaption" TargetType="TextBlock" BasedOn="{StaticResource GbBody}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource GbTextSecondaryBrush}" />
    </Style>
    <Style x:Key="GbLabel" TargetType="TextBlock" BasedOn="{StaticResource GbBody}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Foreground" Value="{StaticResource GbTextMutedBrush}" />
    </Style>
    <Style x:Key="GbTitle" TargetType="TextBlock" BasedOn="{StaticResource GbBody}">
        <Setter Property="FontFamily" Value="{StaticResource GbDisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="GbDisplay" TargetType="TextBlock" BasedOn="{StaticResource GbBody}">
        <Setter Property="FontFamily" Value="{StaticResource GbDisplayFont}" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="FontWeight" Value="Light" />
    </Style>

    <Style x:Key="GbCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GbSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource GbCardRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="GbIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource GbTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource GbControlRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource GbHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource GbPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.35" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="Presenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GbDockItem" TargetType="ListViewItem">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="CornerRadius" Value="{StaticResource GbControlRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
