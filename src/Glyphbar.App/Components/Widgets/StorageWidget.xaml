<UserControl
    x:Class="Glyphbar.App.Components.Widgets.StorageWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Glyphbar.App.ViewModels">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="STORAGE" Style="{StaticResource GbLabel}" VerticalAlignment="Center" />
            <Button Style="{StaticResource GbIconButton}" MinWidth="24" MinHeight="24" Width="24" Height="24" HorizontalAlignment="Right" ToolTipService.ToolTip="Refresh" AutomationProperties.Name="Refresh" Command="{x:Bind ViewModel.RefreshCommand}">
                <FontIcon Glyph="&#xE72C;" FontSize="11" />
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Drives}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DriveViewModel">
                        <StackPanel Spacing="4" Margin="0,0,0,12">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" />
                                    <TextBlock Text="{x:Bind Heading}" Style="{StaticResource GbBody}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind PercentText}" Style="{StaticResource GbCaption}" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Value="{x:Bind Percent}" Maximum="100" Visibility="{x:Bind IsReady}" />
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource GbCaption}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
