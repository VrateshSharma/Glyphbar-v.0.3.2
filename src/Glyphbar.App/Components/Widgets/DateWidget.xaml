<UserControl
    x:Class="Glyphbar.App.Components.Widgets.DateWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comp="using:Glyphbar.App.Components">
    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Bind ViewModel.Weekday, Mode=OneWay}" Style="{StaticResource GbLabel}" />
        <comp:DotMatrixText Grid.Row="1" Text="{x:Bind ViewModel.Day, Mode=OneWay}" DotSize="7" Gap="2.2" VerticalAlignment="Center" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{x:Bind ViewModel.Month, Mode=OneWay}" Style="{StaticResource GbBody}" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind ViewModel.Year, Mode=OneWay}" Style="{StaticResource GbSecondary}" />
        </StackPanel>
    </Grid>
</UserControl>
