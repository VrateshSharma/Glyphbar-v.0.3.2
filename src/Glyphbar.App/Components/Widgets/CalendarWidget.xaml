<UserControl
    x:Class="Glyphbar.App.Components.Widgets.CalendarWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Glyphbar.App.ViewModels">
    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="{x:Bind ViewModel.MonthTitle, Mode=OneWay}" Style="{StaticResource GbBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="0">
                <Button Style="{StaticResource GbIconButton}" MinWidth="26" MinHeight="26" Width="26" Height="26" Command="{x:Bind ViewModel.PreviousYearCommand}" ToolTipService.ToolTip="Previous year" AutomationProperties.Name="Previous year" Visibility="{x:Bind ViewModel.ShowGrid, Mode=OneWay}">
                    <FontIcon Glyph="&#xE892;" FontSize="10" />
                </Button>
                <Button Style="{StaticResource GbIconButton}" MinWidth="26" MinHeight="26" Width="26" Height="26" Command="{x:Bind ViewModel.PreviousMonthCommand}" ToolTipService.ToolTip="Previous month" AutomationProperties.Name="Previous month" Visibility="{x:Bind ViewModel.ShowGrid, Mode=OneWay}">
                    <FontIcon Glyph="&#xE76B;" FontSize="10" />
                </Button>
                <Button Style="{StaticResource GbIconButton}" MinHeight="26" Height="26" Padding="6,0" Command="{x:Bind ViewModel.TodayCommand}" Visibility="{x:Bind ViewModel.ShowGrid, Mode=OneWay}">
                    <TextBlock Text="Today" Style="{StaticResource GbCaption}" />
                </Button>
                <Button Style="{StaticResource GbIconButton}" MinWidth="26" MinHeight="26" Width="26" Height="26" Command="{x:Bind ViewModel.NextMonthCommand}" ToolTipService.ToolTip="Next month" AutomationProperties.Name="Next month" Visibility="{x:Bind ViewModel.ShowGrid, Mode=OneWay}">
                    <FontIcon Glyph="&#xE76C;" FontSize="10" />
                </Button>
                <Button Style="{StaticResource GbIconButton}" MinWidth="26" MinHeight="26" Width="26" Height="26" Command="{x:Bind ViewModel.NextYearCommand}" ToolTipService.ToolTip="Next year" AutomationProperties.Name="Next year" Visibility="{x:Bind ViewModel.ShowGrid, Mode=OneWay}">
                    <FontIcon Glyph="&#xE893;" FontSize="10" />
                </Button>
                <Button Style="{StaticResource GbIconButton}" MinWidth="26" MinHeight="26" Width="26" Height="26" Click="OnAddClick" ToolTipService.ToolTip="New event" AutomationProperties.Name="New event">
                    <FontIcon Glyph="&#xE710;" FontSize="11" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="MonthPanel" Grid.Row="1" Spacing="2" Visibility="{x:Bind ViewModel.ShowGrid, Mode=OneWay}">
            <Grid x:Name="WeekdayGrid" />
            <Grid x:Name="DayGrid" />
        </StackPanel>

        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.VisibleEvents}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnEventClick" Padding="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="6,3" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.Header>
                <TextBlock Text="{x:Bind ViewModel.EventsHeading, Mode=OneWay}" Style="{StaticResource GbLabel}" Margin="0,4,0,4" />
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:CalendarEventViewModel">
                    <StackPanel>
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource GbBody}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind When}" Style="{StaticResource GbCaption}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource GbCaption}" Margin="0,24,0,0" Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" />
    </Grid>
</UserControl>
