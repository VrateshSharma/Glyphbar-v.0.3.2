<UserControl
    x:Class="Glyphbar.App.Components.Widgets.MusicWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="{x:Bind ViewModel.SourceLabel, Mode=OneWay}" Style="{StaticResource GbLabel}" VerticalAlignment="Center" />
            <ComboBox AutomationProperties.Name="Media session" ItemsSource="{x:Bind ViewModel.SessionNames}" SelectedIndex="{x:Bind ViewModel.SelectedSessionIndex, Mode=TwoWay}" Visibility="{x:Bind ViewModel.ShowSelector, Mode=OneWay}" HorizontalAlignment="Right" MinWidth="90" MaxWidth="150" FontSize="11" />
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasSession, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="{x:Bind ViewModel.ArtSize, Mode=OneWay}" Height="{x:Bind ViewModel.ArtSize, Mode=OneWay}" CornerRadius="10" Background="{StaticResource GbElevatedBrush}" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.ShowArtSlot, Mode=OneWay}">
                <Grid>
                    <FontIcon Glyph="&#xEC4F;" FontSize="20" Foreground="{StaticResource GbTextMutedBrush}" />
                    <Image Source="{x:Bind ViewModel.Artwork, Mode=OneWay}" Stretch="UniformToFill" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource GbBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind ViewModel.Artist, Mode=OneWay}" Style="{StaticResource GbSecondary}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind ViewModel.Album, Mode=OneWay}" Style="{StaticResource GbCaption}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="4" Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
            <FontIcon Glyph="&#xEC4F;" FontSize="20" HorizontalAlignment="Left" Foreground="{StaticResource GbTextMutedBrush}" />
            <TextBlock Text="Nothing playing" Style="{StaticResource GbBody}" />
            <TextBlock Text="Start music in any media app to control it here." Style="{StaticResource GbCaption}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.HasSession, Mode=OneWay}">
            <Button Style="{StaticResource GbIconButton}" Command="{x:Bind ViewModel.PreviousCommand}" IsEnabled="{x:Bind ViewModel.CanPrevious, Mode=OneWay}" ToolTipService.ToolTip="Previous" AutomationProperties.Name="Previous">
                <FontIcon Glyph="&#xE892;" FontSize="14" />
            </Button>
            <Button Style="{StaticResource GbIconButton}" Command="{x:Bind ViewModel.PlayPauseCommand}" IsEnabled="{x:Bind ViewModel.CanPlayPause, Mode=OneWay}" ToolTipService.ToolTip="Play or pause" AutomationProperties.Name="Play or pause">
                <FontIcon Glyph="{x:Bind ViewModel.PlayGlyph, Mode=OneWay}" FontSize="16" />
            </Button>
            <Button Style="{StaticResource GbIconButton}" Command="{x:Bind ViewModel.NextCommand}" IsEnabled="{x:Bind ViewModel.CanNext, Mode=OneWay}" ToolTipService.ToolTip="Next" AutomationProperties.Name="Next">
                <FontIcon Glyph="&#xE893;" FontSize="14" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
