<UserControl
    x:Class="Glyphbar.App.Components.BatteryGlyph"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid Width="24" Height="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Shell" BorderBrush="{StaticResource GbTextBrush}" BorderThickness="1.2" CornerRadius="3" Padding="1.5">
            <Grid x:Name="Track">
                <Rectangle x:Name="Fill" HorizontalAlignment="Left" Fill="{StaticResource GbTextBrush}" RadiusX="1" RadiusY="1" />
            </Grid>
        </Border>
        <Rectangle Grid.Column="1" Width="2" Height="5" Margin="1,0,0,0" Fill="{StaticResource GbTextBrush}" RadiusX="1" RadiusY="1" />
        <FontIcon x:Name="Bolt" Glyph="&#xE945;" FontSize="9" Foreground="{StaticResource GbBackgroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
    </Grid>
</UserControl>
