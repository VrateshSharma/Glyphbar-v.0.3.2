<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop rescap">

  <Identity Name="Glyphbar" Publisher="CN=Glyphbar Local" Version="1.0.6.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Glyphbar</DisplayName>
    <PublisherDisplayName>Glyphbar</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Glyphbar" Executable="Glyphbar.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Glyphbar"
        Description="A monochrome taskbar, launcher and widget environment for Windows 11."
        BackgroundColor="#080808"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#080808" />
      </uap:VisualElements>
      <Extensions>
        <!-- Lets the recovery commands in docs/TROUBLESHOOTING.md work from any prompt. -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="Glyphbar.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="Glyphbar.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
        <!-- Disabled until the user turns it on in Settings; it also appears in Windows' Startup apps page. -->
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask TaskId="GlyphbarStartup" Enabled="false" DisplayName="Glyphbar" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
